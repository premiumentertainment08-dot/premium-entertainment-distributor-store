rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /paymentScreenshots/{fileName} {
      // Customer upload: image only, max 5 MB. Admin-only viewing/deleting.
      allow create: if request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, delete: if request.auth != null && request.auth.token.email == "YOUR_ADMIN_EMAIL@example.com";
      allow update: if false;
    }
  }
}
