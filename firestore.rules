rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email == "YOUR_ADMIN_EMAIL@example.com";
    }

    match /products/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Checkout writes to `orders/{orderId}` and tracking reads one exact order.
    match /orders/{orderId} {
      allow create: if request.resource.data.orderId == orderId
                    && request.resource.data.amount is number
                    && request.resource.data.amount >= 0
                    && request.resource.data.status == "Payment Pending"
                    && request.resource.data.paymentStatus == "Pending";
      allow get: if resource.data.orderId == orderId;
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
